<?xml version="1.0" encoding="utf-8"?>
<!-- W41 Day bar · large: 4×4 (daybar) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="368dp"
    android:maxResizeHeight="368dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/kfw_loading"
    android:previewImage="@drawable/kfw_preview_w41"
    android:description="@string/kfw_desc_41"
    android:widgetCategory="home_screen" />
