<?xml version="1.0" encoding="utf-8"?>
<!-- A · Top 3 on the lock screen (LockWidget): home_screen|keyguard, for Good Lock › LockStar. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/kfl_top3"
    android:initialKeyguardLayout="@layout/kfl_top3"
    android:previewLayout="@layout/kfl_top3_preview"
    android:description="@string/kfl_desc"
    android:widgetCategory="home_screen|keyguard" />
