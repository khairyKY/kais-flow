<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widgets, the family style (widgets-build 2026-10-26, design-export/Phone home options.html "Existing
     widgets" + the B · Now card family): an opaque paper card at the system corner radius, sentence-case labels with
     a line icon, palette C blocks, the paper goal strip, a terra pill for the main action. Stock fonts only
     (RemoteViews): sans for the UI, serif for the goal and big numbers, cursive for the journal's hand. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="KfW" />

    <!-- The card: paper, the system radius (kfw_dimens), a 1dp line; opaque, so it reads on any wallpaper. -->
    <style name="KfW.Root">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/kfw_card</item>
        <item name="android:clipToOutline" tools:targetApi="31">true</item>
    </style>
    <style name="KfW.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="KfW.Body.Square" />
    <!-- One-row widgets: centred vertically. -->
    <style name="KfW.Body.Slim">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Text -->
    <style name="KfW.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/kfw_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- A label (the header's "Top 3", "Up next", "Routines"): sentence case, 13, medium. -->
    <style name="KfW.Cap" parent="KfW.Text">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- Its quiet half ("· 1 of 8 done", "in 20m"). -->
    <style name="KfW.Q" parent="KfW.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/kfw_ink_faint</item>
    </style>
    <!-- A row's meta (lengths, counts, a foot line). -->
    <style name="KfW.Meta" parent="KfW.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kfw_ink_muted</item>
    </style>
    <!-- A clock time, tabular. -->
    <style name="KfW.Time" parent="KfW.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/kfw_ink_faint</item>
    </style>
    <!-- The goal's stamp ("✶ Goal · 1:30–3:30 PM"): the one spaced, upper-case line, in gold. -->
    <style name="KfW.Stamp" parent="KfW.Text">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/kfw_gold</item>
    </style>
    <style name="KfW.Serif" parent="KfW.Text">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="KfW.Serif.Bold">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="KfW.Title" parent="KfW.Text">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="KfW.Hand" parent="KfW.Text">
        <item name="android:fontFamily">cursive</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/kfw_ink_hand</item>
    </style>

    <!-- A 30dp pill: bone with a control line (secondary), or terra (the one main action). -->
    <style name="KfW.Btn" parent="KfW.Text">
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/kfw_pill_bone</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12.5sp</item>
    </style>
    <style name="KfW.Btn.Cta">
        <item name="android:background">@drawable/kfw_pill_terra</item>
        <item name="android:textColor">@color/kfw_on_terra</item>
    </style>
    <!-- A 34dp round button with a line icon (mic, Paper). -->
    <style name="KfW.Round">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/kfw_circle_bone</item>
        <item name="android:tint">@color/kfw_ink_muted</item>
    </style>
    <!-- The terra + (28dp) in a header. -->
    <style name="KfW.Round.Cta">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/kfw_circle_terra</item>
        <item name="android:tint">@color/kfw_on_terra</item>
    </style>
    <!-- A header's line icon, 15dp, muted. -->
    <style name="KfW.Icon">
        <item name="android:layout_width">15dp</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/kfw_ink_muted</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- The checkbox before Android 12 (layout/kfw_box.xml): the 20dp box in a 32dp hit. -->
    <style name="KfW.Box">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/kfw_box</item>
    </style>
    <!-- The hairline between rows. -->
    <style name="KfW.Dash">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/kfw_line_card</item>
    </style>
    <style name="KfW.Fill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>
</resources>
