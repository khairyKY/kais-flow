<?xml version="1.0" encoding="utf-8"?>
<!-- W13 Ask (4×1): the chat with the question typed; the chip sends a starter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim">
        <LinearLayout android:id="@+id/ask" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:background="@drawable/kfw_pill_bone" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
            <ImageView style="@style/KfW.Icon" android:src="@drawable/kfw_ic_chat" android:tint="@color/kfw_ink_faint" />
            <TextView style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Ask about your day…" android:textColor="@color/kfw_ink_faint" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:id="@+id/chip" style="@style/KfW.Btn" android:layout_marginStart="8dp" android:text="What should I drop?" />
    </LinearLayout>
</FrameLayout>
