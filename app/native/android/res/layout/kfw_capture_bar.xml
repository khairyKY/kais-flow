<?xml version="1.0" encoding="utf-8"?>
<!-- W11 Capture bar (4×1): type, talk, or write on paper (Paper capture). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim">
        <LinearLayout android:id="@+id/type" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:background="@drawable/kfw_pill_bone" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
            <ImageView style="@style/KfW.Icon" android:src="@drawable/kfw_ic_plus" android:tint="@color/kfw_ink_faint" />
            <TextView style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="What’s on your mind?" android:textColor="@color/kfw_ink_faint" android:textSize="13sp" />
        </LinearLayout>
        <ImageView android:id="@+id/mic" style="@style/KfW.Round" android:layout_marginStart="8dp" android:src="@drawable/kfw_ic_mic" android:contentDescription="Talk" />
        <ImageView android:id="@+id/paper" style="@style/KfW.Round" android:layout_marginStart="8dp" android:src="@drawable/kfw_ic_journal" android:contentDescription="Write on paper" />
    </LinearLayout>
</FrameLayout>
