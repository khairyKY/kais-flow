<?xml version="1.0" encoding="utf-8"?>
<!-- W11 Capture bar (4×1): type, talk, or write on paper -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim" android:paddingStart="12dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/type" style="@style/KfW.Text" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/kfw_pill_bone" android:drawableStart="@drawable/kfw_ic_plus" android:drawablePadding="10dp" android:drawableTint="@color/kfw_ink_faint" android:fontFamily="serif" android:textStyle="italic" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="What’s on your mind?" android:textColor="@color/kfw_ink_faint" android:textSize="15sp" />
        <ImageView android:id="@+id/mic" style="@style/KfW.Round" android:layout_marginStart="8dp" android:src="@drawable/kfw_ic_mic" android:contentDescription="Talk" />
        <ImageView android:id="@+id/paper" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:padding="10dp" android:scaleType="fitCenter" android:background="@drawable/kfw_circle_bone" android:src="@drawable/kfw_art_tools_pen" android:contentDescription="Write on paper" />
    </LinearLayout>
</FrameLayout>
