<?xml version="1.0" encoding="utf-8"?>
<!-- Routines · week row: the box, the routine, its last seven days as petals (blossom) and sage -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/box" style="@style/KfW.Box" android:layout_height="34dp" android:contentDescription="Tick" />
    <TextView android:id="@+id/title" style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="1dp" android:textSize="14sp" />
    <ImageView android:id="@+id/d0" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="10dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d1" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d2" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d3" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d4" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d5" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/d6" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="3dp" android:src="@drawable/kfw_dot_empty" android:importantForAccessibility="no" />
</LinearLayout>
