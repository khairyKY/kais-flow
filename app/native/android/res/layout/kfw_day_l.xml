<?xml version="1.0" encoding="utf-8"?>
<!-- W41 · Day bar large (4×4): the bar, Next, the goal, the Top 3 to tick, and the capture bar at the foot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <include layout="@layout/kfw_daybar" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical" />
        <include layout="@layout/kfw_goal_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Fill" />
        <include layout="@layout/kfw_capbar" />
    </LinearLayout>
</FrameLayout>
