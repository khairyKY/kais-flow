<?xml version="1.0" encoding="utf-8"?>
<!-- W15 Agenda + week (4×4): the week strip on top (dots = days with things), the day below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/date" style="@style/KfW.Serif" android:layout_width="0dp" android:layout_weight="1" android:textSize="19sp" />
            <include layout="@layout/kfw_stale_stamp" />
            <ImageView android:id="@+id/add" style="@style/KfW.Round.Cta" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:padding="10.4dp" android:src="@drawable/kfw_ic_plus" android:contentDescription="Capture" />
        </LinearLayout>
        <LinearLayout android:id="@+id/days" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/empty" style="@style/KfW.Title" android:textColor="@color/kfw_ink_muted" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
