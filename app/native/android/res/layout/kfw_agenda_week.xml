<?xml version="1.0" encoding="utf-8"?>
<!-- W15 Agenda + week (4×4): the date and the +, the week with today in the calendar's lavender, then the day's
     column (as W14). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <LinearLayout android:id="@+id/days" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" />
        <FrameLayout android:id="@+id/lane" style="@style/KfW.Fill" android:layout_marginTop="6dp" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical" android:visibility="gone" />
        <TextView android:id="@+id/empty" style="@style/KfW.Meta" android:layout_marginTop="10dp" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
