<?xml version="1.0" encoding="utf-8"?>
<!-- C · the Day strip notification, collapsed (LockScreen.strip): the block that's on, and the widgets' slim Day bar
     (DayBar, one bitmap per theme). Text in the system's notification styles, so it follows the shade. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/kfl_title" style="@style/TextAppearance.Compat.Notification.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" />
    <include layout="@layout/kfw_daybar" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" />
</LinearLayout>
