<?xml version="1.0" encoding="utf-8"?>
<!-- W20 Focus · slim (2×1), Focus D3: the minutes left, "Focusing · 2 of 4" and the task on two lines, the segment bar under them (no ring). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/mins" style="@style/KfW.Text" android:minWidth="44dp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="17sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/cap" style="@style/KfW.Q" android:textSize="11sp" android:text="Focusing" />
                <TextView android:id="@+id/title" style="@style/KfW.Title" android:layout_width="match_parent" android:layout_marginTop="1dp" android:textSize="13sp" android:lineSpacingMultiplier="1.1" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/kfw_focusbar" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="7dp" />
    </LinearLayout>
</FrameLayout>
