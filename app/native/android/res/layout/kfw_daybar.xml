<?xml version="1.0" encoding="utf-8"?>
<!-- The Day bar (DayBar): two bitmaps, one per theme; the day bitmap shows (layout-night/ has the night one), so the system dark mode
     needs no redraw. Tapping it opens today's calendar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bar_day" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Today's blocks" android:visibility="visible" />
    <ImageView android:id="@+id/bar_night" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Today's blocks" android:visibility="gone" />
</FrameLayout>
