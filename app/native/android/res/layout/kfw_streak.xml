<?xml version="1.0" encoding="utf-8"?>
<!-- W23 Streak plant (2×2): one routine's vine, at its stage, with the goal -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Square">
        <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_width="match_parent" android:textColor="@color/kfw_streak" />
        <FrameLayout style="@style/KfW.Fill">
            <ImageView android:id="@+id/art" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="bottom|center_horizontal" android:adjustViewBounds="true" android:maxHeight="92dp" android:src="@drawable/kfw_art_vine_flowering" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_width="0dp" android:layout_weight="1" android:textSize="18sp" />
            <TextView android:id="@+id/time" style="@style/KfW.Meta" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
