<?xml version="1.0" encoding="utf-8"?>
<!-- W18 Focus, idle (2×2): the coiled fern, the round's length, Start. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <FrameLayout style="@style/KfW.Fill">
            <ImageView android:layout_width="wrap_content" android:layout_height="56dp" android:layout_gravity="center" android:adjustViewBounds="true" android:src="@drawable/kfw_art_fern_coil" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Meta" android:layout_width="match_parent" android:gravity="center" android:textSize="12.5sp" />
        <TextView android:id="@+id/start" style="@style/KfW.Btn.Cta" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp" android:text="Start" />
    </LinearLayout>
</FrameLayout>
