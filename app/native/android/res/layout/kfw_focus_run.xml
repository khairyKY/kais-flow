<?xml version="1.0" encoding="utf-8"?>
<!-- W18 Focus (2×2): the ring in the task's block colour, the time left, the task, Stop and Done. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <FrameLayout style="@style/KfW.Fill">
            <FrameLayout android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center">
                <ProgressBar android:id="@+id/ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/kfw_ring_big" />
                <Chronometer android:id="@+id/left" style="@style/KfW.Text" android:layout_gravity="center" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="15sp" />
            </FrameLayout>
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Title" android:layout_width="match_parent" android:gravity="center" android:textSize="12.5sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:id="@+id/stop" style="@style/KfW.Btn" android:text="Stop" />
            <TextView android:id="@+id/done" style="@style/KfW.Btn.Cta" android:layout_marginStart="6dp" android:text="Done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
