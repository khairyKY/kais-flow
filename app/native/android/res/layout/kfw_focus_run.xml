<?xml version="1.0" encoding="utf-8"?>
<!-- W18 Focus timer (2×2): ring, minutes left, the task, Stop and Done -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Square">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_width="0dp" android:layout_weight="1" android:textColor="@color/kfw_sage_text" android:text="Focus" />
            <ImageView style="@style/KfW.Icon" android:src="@drawable/kfw_ic_focus" />
        </LinearLayout>
        <FrameLayout style="@style/KfW.Fill">
            <FrameLayout android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="center">
                <ProgressBar android:id="@+id/ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/kfw_ring_big" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                    <Chronometer android:id="@+id/left" style="@style/KfW.Serif.Bold" android:fontFeatureSettings="tnum" android:textSize="20sp" />
                    <TextView android:id="@+id/left_cap" style="@style/KfW.Cap" android:textSize="10sp" android:text="left" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Title" android:layout_width="match_parent" android:gravity="center" android:textColor="@color/kfw_ink_muted" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
            <ImageView android:id="@+id/stop" style="@style/KfW.Round" android:layout_width="36dp" android:layout_height="36dp" android:padding="10.4dp" android:src="@drawable/kfw_ic_stop" android:contentDescription="Stop" />
            <ImageView android:id="@+id/done" style="@style/KfW.Round.Cta" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:padding="10.4dp" android:src="@drawable/kfw_ic_check" android:contentDescription="Done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
