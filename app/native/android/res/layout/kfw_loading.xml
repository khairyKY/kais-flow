<?xml version="1.0" encoding="utf-8"?>
<!-- S5 First paint: skeleton rows, only before the very first sync (every widget's initialLayout) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Square">
        <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:text="Kai’s Flow" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="4dp">
            <FrameLayout android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="0.7" android:layout_marginStart="12dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="4dp">
            <FrameLayout android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="0.55" android:layout_marginStart="12dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.45" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="4dp">
            <FrameLayout android:layout_width="22dp" android:layout_height="22dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="0.62" android:layout_marginStart="12dp" android:background="@drawable/kfw_skel" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0.38" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
