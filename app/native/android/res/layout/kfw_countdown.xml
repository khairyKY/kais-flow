<?xml version="1.0" encoding="utf-8"?>
<!-- W17 Countdown (2×1): what you count to and its date, then the days, in the serif. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/cap" style="@style/KfW.Meta" android:layout_width="match_parent" android:textSize="11.5sp" />
            <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_marginTop="2dp" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
