<?xml version="1.0" encoding="utf-8"?>
<!-- W31 One line (4×2): the journal's line for today — write or say it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/KfW.Cap" android:layout_width="0dp" android:layout_weight="1" android:text="One line about today" />
            <ImageView style="@style/KfW.Icon" android:src="@drawable/kfw_ic_journal" />
        </LinearLayout>
        <LinearLayout style="@style/KfW.Fill" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:orientation="vertical">
            <TextView android:id="@+id/line" style="@style/KfW.Hand" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="24sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/kfw_line_dashed" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|end" android:orientation="horizontal">
            <ImageView android:id="@+id/mic" style="@style/KfW.Round" android:layout_width="40dp" android:layout_height="40dp" android:padding="11.6dp" android:src="@drawable/kfw_ic_mic" android:contentDescription="Say it" />
            <TextView android:id="@+id/write" style="@style/KfW.Btn.Cta" android:layout_marginStart="8dp" android:drawableStart="@drawable/kfw_ic_send" android:text="Write" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
