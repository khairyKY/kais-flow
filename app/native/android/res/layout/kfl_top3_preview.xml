<?xml version="1.0" encoding="utf-8"?>
<!-- A · Top 3 on the lock screen (LockWidget) — the picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/kfl_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/kfl_card" android:orientation="vertical" android:paddingStart="6dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Top 3" android:textColor="@color/kfl_muted" android:textSize="13sp" />
        <TextView android:id="@+id/kfl_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/kfl_muted" android:textSize="13sp" android:text="0/3" />
    </LinearLayout>
    <TextView android:id="@+id/kfl_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingTop="10dp" android:text="Nothing starred yet" android:textColor="@color/kfl_muted" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/kfl_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/kfl_box1" android:layout_width="44dp" android:layout_height="40dp" android:scaleType="center" android:src="@drawable/kfl_box" android:contentDescription="Tick" />
        <TextView android:id="@+id/kfl_title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:fontFamily="serif" android:textColor="@color/kfl_gold" android:textSize="15sp" android:text="✶ Finish the CNN notes" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kfl_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/kfl_box2" android:layout_width="44dp" android:layout_height="40dp" android:scaleType="center" android:src="@drawable/kfl_box" android:contentDescription="Tick" />
        <TextView android:id="@+id/kfl_title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:fontFamily="sans-serif" android:textColor="@color/kfl_ink" android:textSize="14sp" android:text="Gym · legs" />
    </LinearLayout>
    <LinearLayout android:id="@+id/kfl_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/kfl_box3" android:layout_width="44dp" android:layout_height="40dp" android:scaleType="center" android:src="@drawable/kfl_box" android:contentDescription="Tick" />
        <TextView android:id="@+id/kfl_title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:fontFamily="sans-serif" android:textColor="@color/kfl_ink" android:textSize="14sp" android:text="Call Mum" />
    </LinearLayout>
</LinearLayout>
