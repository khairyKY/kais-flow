<?xml version="1.0" encoding="utf-8"?>
<!-- A row you can tick (the app's row): the box, the title on one line, its length or time on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:orientation="horizontal">
    <include layout="@layout/kfw_box" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="-6dp" />
    <TextView android:id="@+id/title" style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="2dp" android:textSize="13.5sp" />
    <TextView android:id="@+id/time" style="@style/KfW.Meta" android:layout_marginStart="8dp" android:fontFeatureSettings="tnum" android:visibility="gone" />
</LinearLayout>
