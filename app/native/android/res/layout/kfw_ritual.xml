<?xml version="1.0" encoding="utf-8"?>
<!-- W29 Plan my day / Shut down (4×2): one header line (the daisy, Morning or Evening, its state and length),
     the title with its one button, and the ritual's four steps as chips. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="26dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/art" android:layout_width="wrap_content" android:layout_height="22dp" android:adjustViewBounds="true" android:src="@drawable/kfw_art_daisy_morning" android:importantForAccessibility="no" />
            <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_marginStart="6dp" />
            <TextView android:id="@+id/q" style="@style/KfW.Q" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_width="match_parent" android:textSize="17sp" />
                <TextView android:id="@+id/meta" style="@style/KfW.Meta" android:layout_width="match_parent" android:layout_marginTop="2dp" />
            </LinearLayout>
            <TextView android:id="@+id/go" style="@style/KfW.Btn.Cta" android:layout_marginStart="10dp" />
        </LinearLayout>
        <FrameLayout style="@style/KfW.Fill" />
        <LinearLayout android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/s1" style="@style/KfW.Meta" android:layout_height="24dp" android:layout_marginEnd="5dp" android:background="@drawable/kfw_chip_step" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:textColor="@color/kfw_ink" android:textSize="11.5sp" />
            <TextView android:id="@+id/s2" style="@style/KfW.Meta" android:layout_height="24dp" android:layout_marginEnd="5dp" android:background="@drawable/kfw_chip_step" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:textColor="@color/kfw_ink" android:textSize="11.5sp" />
            <TextView android:id="@+id/s3" style="@style/KfW.Meta" android:layout_height="24dp" android:layout_marginEnd="5dp" android:background="@drawable/kfw_chip_step" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:textColor="@color/kfw_ink" android:textSize="11.5sp" />
            <TextView android:id="@+id/s4" style="@style/KfW.Meta" android:layout_height="24dp" android:layout_marginEnd="5dp" android:background="@drawable/kfw_chip_step" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:textColor="@color/kfw_ink" android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
