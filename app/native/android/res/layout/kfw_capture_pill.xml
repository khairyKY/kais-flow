<?xml version="1.0" encoding="utf-8"?>
<!-- W10 Capture pill (2×1): the seal with a word -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Slim">
        <ImageView android:id="@+id/seal" style="@style/KfW.Round.Cta" android:src="@drawable/kfw_ic_plus" android:contentDescription="Capture" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView style="@style/KfW.Serif" android:textSize="16sp" android:text="Capture" />
            <TextView android:id="@+id/meta" style="@style/KfW.Meta" android:layout_marginTop="2dp" android:letterSpacing="0" android:textSize="11sp" android:text="tap to type" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
