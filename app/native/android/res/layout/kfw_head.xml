<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's header line: a line icon, a sentence-case label, its quiet half ("· 1 of 8 done"), and on the right
     the stale stamp, a live countdown, a quiet word, or the terra + (Render.head). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/head_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="26dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/head_icon" style="@style/KfW.Icon" android:layout_marginEnd="6dp" android:visibility="gone" />
    <TextView android:id="@+id/head" style="@style/KfW.Cap" />
    <TextView android:id="@+id/head_q" style="@style/KfW.Q" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" />
    <include layout="@layout/kfw_stale_stamp" />
    <Chronometer android:id="@+id/head_cd" style="@style/KfW.Q" android:layout_marginStart="8dp" android:fontFeatureSettings="tnum" android:visibility="gone" />
    <TextView android:id="@+id/head_r" style="@style/KfW.Q" android:layout_marginStart="8dp" android:fontFeatureSettings="tnum" android:visibility="gone" />
    <ImageView android:id="@+id/add" style="@style/KfW.Round.Cta" android:layout_marginStart="8dp" android:src="@drawable/kfw_ic_plus" android:contentDescription="Add a task" android:visibility="gone" />
</LinearLayout>
