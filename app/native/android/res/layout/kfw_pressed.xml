<?xml version="1.0" encoding="utf-8"?>
<!-- W33 Pressed (2×2): the latest herbarium specimen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Square">
        <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_width="match_parent" />
        <FrameLayout style="@style/KfW.Fill" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="@drawable/kfw_specimen_bg">
            <ImageView android:id="@+id/art" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:adjustViewBounds="true" android:maxHeight="82dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:src="@drawable/kfw_art_wisteria_p80" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Text" android:layout_width="match_parent" android:fontFamily="serif" android:textStyle="italic" android:gravity="center" android:textColor="@color/kfw_ink_muted" android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
