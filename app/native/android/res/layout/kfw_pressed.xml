<?xml version="1.0" encoding="utf-8"?>
<!-- W33 Pressed (2×2): the latest herbarium specimen on its paper. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <FrameLayout style="@style/KfW.Fill" android:layout_marginTop="6dp" android:background="@drawable/kfw_specimen_bg">
            <ImageView android:id="@+id/art" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:adjustViewBounds="true" android:maxHeight="78dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:src="@drawable/kfw_art_wisteria_p80" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Text" android:layout_width="match_parent" android:layout_marginTop="4dp" android:fontFamily="serif" android:textStyle="italic" android:gravity="center" android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
