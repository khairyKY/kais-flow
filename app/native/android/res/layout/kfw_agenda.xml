<?xml version="1.0" encoding="utf-8"?>
<!-- W14 Agenda (4×3): today's blocks from the next one on, with the now line -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/KfW.Serif" android:textSize="19sp" android:text="Today" />
            <TextView android:id="@+id/count" style="@style/KfW.Cap" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="end" />
            <include layout="@layout/kfw_stale_stamp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
        <TextView android:id="@+id/empty" style="@style/KfW.Title" android:layout_marginTop="10dp" android:textColor="@color/kfw_ink_muted" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
