<?xml version="1.0" encoding="utf-8"?>
<!-- W21 Routines (2×2) and W22 Routines · week (4×2): today's routines, ticked in place -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_width="0dp" android:layout_weight="1" android:text="Routines" />
            <TextView android:id="@+id/count" style="@style/KfW.Cap" android:textColor="@color/kfw_sage_text" />
            <LinearLayout android:id="@+id/best" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <ImageView style="@style/KfW.Icon" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/kfw_ic_routines" />
                <TextView android:id="@+id/best_text" style="@style/KfW.Meta" android:layout_marginStart="5dp" android:textColor="@color/kfw_streak" />
            </LinearLayout>
            <include layout="@layout/kfw_stale_stamp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
