<?xml version="1.0" encoding="utf-8"?>
<!-- W5 Today · full page (4×4): goal, picks, up next, and a capture bar at the foot -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body" android:paddingTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/date" style="@style/KfW.Serif" android:layout_width="0dp" android:layout_weight="1" android:textSize="20sp" />
            <include layout="@layout/kfw_stale_stamp" />
            <ImageView android:id="@+id/add" style="@style/KfW.Round.Cta" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="11.6dp" android:src="@drawable/kfw_ic_plus" android:contentDescription="Capture" />
        </LinearLayout>
        <TextView android:id="@+id/planned" style="@style/KfW.Meta" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/kfw_goal_inner" android:orientation="horizontal" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingStart="3dp">
                <ImageView android:id="@+id/box" style="@style/KfW.Box" android:src="@drawable/kfw_box_gold" android:contentDescription="Tick the goal" />
                <LinearLayout android:id="@+id/open" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:orientation="vertical">
                    <TextView style="@style/KfW.Cap" android:textColor="@color/kfw_gold" android:text="✶ Goal of the day" />
                    <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_width="match_parent" android:layout_marginTop="3dp" android:maxLines="2" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/time" style="@style/KfW.Meta" android:textColor="@color/kfw_gold" />
                        <Chronometer android:id="@+id/in" style="@style/KfW.Meta" android:textColor="@color/kfw_gold" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="wrap_content" android:layout_height="17dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="-6dp" android:adjustViewBounds="true" android:src="@drawable/kfw_tape" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Dash" />
        <LinearLayout android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/KfW.Cap" android:text="Up next" />
            <TextView android:id="@+id/next_title" style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="14sp" />
            <TextView android:id="@+id/next_time" style="@style/KfW.Meta" android:layout_marginStart="10dp" />
        </LinearLayout>
        <FrameLayout style="@style/KfW.Fill" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/capture" style="@style/KfW.Title" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/kfw_pill_bone" android:drawableStart="@drawable/kfw_ic_plus" android:drawablePadding="8dp" android:drawableTint="@color/kfw_ink_faint" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Capture — tap to type" android:textColor="@color/kfw_ink_faint" android:textSize="14sp" />
            <ImageView android:id="@+id/mic" style="@style/KfW.Round" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:padding="11.6dp" android:src="@drawable/kfw_ic_mic" android:contentDescription="Talk" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
