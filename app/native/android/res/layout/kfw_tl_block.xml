<?xml version="1.0" encoding="utf-8"?>
<!-- Timeline (Android 12+): a block in a calendar column, placed by its top margin and sized by its height — the
     calendar's own block: palette C fill and edge, the check square for a task, the title (two lines when there's
     room), its time range in the block's text tone, the gold rule for the goal. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tl" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="42dp" android:layout_marginEnd="4dp" android:background="@drawable/kfw_blk_iris">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/blk_k" android:layout_width="11dp" android:layout_height="11dp" android:layout_marginTop="2dp" android:layout_marginEnd="5dp" android:src="@drawable/kfw_k" android:importantForAccessibility="no" android:visibility="gone" />
            <TextView android:id="@+id/blk_star" style="@style/KfW.Title" android:layout_marginEnd="3dp" android:text="✶" android:textColor="@color/kfw_gold" android:textSize="12sp" android:visibility="gone" />
            <TextView android:id="@+id/blk_title" style="@style/KfW.Title" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/blk_time" style="@style/KfW.Time" android:layout_marginTop="1dp" android:textSize="10.5sp" />
    </LinearLayout>
    <ImageView android:id="@+id/blk_goal" android:layout_width="3dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/kfw_rule_gold" android:importantForAccessibility="no" android:visibility="gone" />
</FrameLayout>
