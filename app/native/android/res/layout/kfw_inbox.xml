<?xml version="1.0" encoding="utf-8"?>
<!-- W25 Inbox (2×2): the hydrangea fills with the count; Sort them opens triage. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/art" android:layout_width="wrap_content" android:layout_height="66dp" android:adjustViewBounds="true" android:src="@drawable/kfw_art_hydrangea_medium" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/count" style="@style/KfW.Serif.Bold" android:textSize="26sp" />
                <TextView style="@style/KfW.Meta" android:text="to sort" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout style="@style/KfW.Fill" />
        <TextView android:id="@+id/sort" style="@style/KfW.Btn" android:text="Sort them" />
    </LinearLayout>
</FrameLayout>
