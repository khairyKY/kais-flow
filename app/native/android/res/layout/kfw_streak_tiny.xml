<?xml version="1.0" encoding="utf-8"?>
<!-- W24 Streak · tiny (1×1): the sprout and the count -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
        <ImageView android:layout_width="wrap_content" android:layout_height="34dp" android:adjustViewBounds="true" android:src="@drawable/kfw_art_vine_sprouting" android:importantForAccessibility="no" />
        <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_marginTop="2dp" android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
