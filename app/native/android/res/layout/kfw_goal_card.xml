<?xml version="1.0" encoding="utf-8"?>
<!-- W02 Goal of the day · card (2×2): the taped paper card — the gold stamp and the clover, the title in the serif,
     the gold box and its time and length. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root" android:background="@drawable/kfw_card_goal">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body" android:paddingTop="14dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView style="@style/KfW.Stamp" android:layout_width="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:text="✶ Goal of the day" />
            <ImageView android:layout_width="wrap_content" android:layout_height="24dp" android:adjustViewBounds="true" android:src="@drawable/kfw_art_clover_four_leaf" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_width="match_parent" android:layout_marginTop="6dp" android:textSize="16sp" android:lineSpacingMultiplier="1.1" android:maxLines="3" />
        <FrameLayout style="@style/KfW.Fill" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <include layout="@layout/kfw_box_gold" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="-6dp" />
            <TextView android:id="@+id/time" style="@style/KfW.Meta" android:layout_marginStart="2dp" android:fontFeatureSettings="tnum" android:textColor="@color/kfw_gold" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="46dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="-1dp" android:scaleType="fitXY" android:src="@drawable/kfw_tape" android:importantForAccessibility="no" />
</FrameLayout>
