<?xml version="1.0" encoding="utf-8"?>
<!-- W6 Now (4×2): what is running, time left, a thin progress line; Start focus or Done.
     With nothing running it shows the next block. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/cap" style="@style/KfW.Cap" android:layout_width="0dp" android:layout_weight="1" android:textColor="@color/kfw_terra_ink" android:text="Now" />
            <TextClock android:id="@+id/clock" style="@style/KfW.Meta" android:format12Hour="HH:mm" android:format24Hour="HH:mm" />
        </LinearLayout>
        <LinearLayout android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <ImageView android:id="@+id/rule" android:layout_width="4dp" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/kfw_rule_gold" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/title" style="@style/KfW.Serif.Bold" android:layout_width="match_parent" android:textSize="19sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/time" style="@style/KfW.Meta" />
                    <Chronometer android:id="@+id/left" style="@style/KfW.Meta" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:max="1000" android:progressDrawable="@drawable/kfw_bar_gold" />
        <FrameLayout style="@style/KfW.Fill" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/focus" style="@style/KfW.Btn.Cta" android:drawableStart="@drawable/kfw_ic_focus" android:text="Start focus" />
            <TextView android:id="@+id/done" style="@style/KfW.Btn" android:layout_marginStart="8dp" android:drawableStart="@drawable/kfw_ic_check" android:text="Done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
