<?xml version="1.0" encoding="utf-8"?>
<!-- W06 Now (4×2): the Now card (what runs, or Up next, in its palette C colour), then the block after it, with
     Start focus and Done. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_nowhead" />
        <LinearLayout android:id="@+id/slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Fill" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/focus" style="@style/KfW.Btn.Cta" android:text="Start focus" />
            <TextView android:id="@+id/done" style="@style/KfW.Btn" android:layout_marginStart="8dp" android:text="Done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
