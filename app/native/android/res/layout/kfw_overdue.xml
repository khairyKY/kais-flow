<?xml version="1.0" encoding="utf-8"?>
<!-- W27 Overdue (2×2): the count, the oldest, and Replan all -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <ImageView android:id="@+id/grain" style="@style/KfW.Grain" />
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body.Square">
        <TextView style="@style/KfW.Cap" android:textColor="@color/kfw_overdue" android:text="Overdue" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:baselineAligned="true" android:orientation="horizontal">
            <TextView android:id="@+id/count" style="@style/KfW.Serif.Bold" android:textColor="@color/kfw_terra_ink" android:textSize="34sp" />
            <TextView android:id="@+id/time" style="@style/KfW.Meta" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Fill" />
        <TextView android:id="@+id/replan" style="@style/KfW.Btn.Cta" android:drawableStart="@drawable/kfw_ic_pickdate" android:text="Replan all" />
    </LinearLayout>
</FrameLayout>
