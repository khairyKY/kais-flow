<?xml version="1.0" encoding="utf-8"?>
<!-- W27 Overdue (2×2): the count in terra and the oldest, two titles, Replan all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:baselineAligned="true" android:orientation="horizontal">
            <TextView android:id="@+id/count" style="@style/KfW.Serif.Bold" android:textColor="@color/kfw_terra_ink" android:textSize="26sp" />
            <TextView android:id="@+id/time" style="@style/KfW.Meta" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Fill" />
        <TextView android:id="@+id/replan" style="@style/KfW.Btn.Cta" android:text="Replan all" />
    </LinearLayout>
</FrameLayout>
