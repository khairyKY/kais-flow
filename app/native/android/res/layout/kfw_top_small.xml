<?xml version="1.0" encoding="utf-8"?>
<!-- W03 · Checklist small (2×2): ☆ Top 3 · 0/3, the paper goal strip, then the picks to tick. S3 Offline / stale
     shows the stamp in the header and a foot line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" style="@style/KfW.Root">
    <LinearLayout android:id="@+id/body" style="@style/KfW.Body">
        <include layout="@layout/kfw_head" />
        <include layout="@layout/kfw_goal_strip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="vertical" />
        <FrameLayout style="@style/KfW.Fill" />
        <TextView android:id="@+id/stale_foot" style="@style/KfW.Meta" android:textColor="@color/kfw_offline" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
