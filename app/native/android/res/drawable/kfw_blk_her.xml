<?xml version="1.0" encoding="utf-8"?>
<!-- Her block (Her day): palette C Heather, as kfw_blk_heather, with the dashed edge her blocks have on the calendar lane. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kfw_blk_heather_fill" />
    <stroke android:width="1dp" android:color="@color/kfw_blk_heather" android:dashWidth="4dp" android:dashGap="3dp" />
    <corners android:radius="@dimen/kfw_r_block" />
</shape>
