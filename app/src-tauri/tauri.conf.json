{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kai's Flow",
  "version": "1.0.0",
  "identifier": "com.kaisflow.garden",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kai's Flow",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600,
        "useHttpsScheme": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/kaisflow.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNzBERDM5M0JCQ0RENkQKUldSdDNidzdPZDF3YkhvVGYvOHNURmNPZklwYStna1h3SG9OdEE0KzlDWFdxVU01MURodkZLZEcK",
      "endpoints": ["https://github.com/khairyKY/kais-flow/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
